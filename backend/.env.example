# ==============================================================================
# FLOODMAP LIVE — BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# NASA Space Apps Challenge 2026: Dancing with the SARs
# ==============================================================================

# Server Hosting Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 1. NASA EARTHDATA LOGIN CREDENTIALS (REQUIRED FOR DOWNLOADING REAL DATA)
# ------------------------------------------------------------------------------
# Register for a free NASA Earthdata account at:
# https://urs.earthdata.nasa.gov/users/new
#
# Insert your Earthdata account credentials below:
EARTHDATA_USERNAME=your_nasa_earthdata_username_here
EARTHDATA_PASSWORD=your_nasa_earthdata_password_here

# Alternatively, generate an Earthdata User Token at:
# https://urs.earthdata.nasa.gov/user_tokens
EARTHDATA_TOKEN=

# ------------------------------------------------------------------------------
# 2. COPERNICUS DATASPACE ECOSYSTEM (ESA SENTINEL-1 COMPLEMENTARY ACCESS)
# ------------------------------------------------------------------------------
# Register at: https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here

# ------------------------------------------------------------------------------
# 3. GEOSPATIAL STORAGE PATHS
# ------------------------------------------------------------------------------
# Path to local datasets directory (defaults to the frontend public data directory)
DATASET_STORAGE_PATH=../frontend/public/data
PROCESSED_OUTPUT_PATH=../frontend/public/data/nisar
CACHE_EXPIRATION_HOURS=24
